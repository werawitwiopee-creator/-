--  ANIMATION HELPERS
local function tween(obj, props, dur, style, dir)
    style = style or Enum.EasingStyle.Quad
    dir   = dir   or Enum.EasingDirection.Out
    TweenService:Create(obj, TweenInfo.new(dur or 0.2, style, dir), props):Play()
end

local pulseConn = nil
local function startPulse()
    if pulseConn then pulseConn:Disconnect() end
    local t = 0
    pulseConn = RunService.Heartbeat:Connect(function(dt)
        t = t + dt
        local s = 0.85 + math.sin(t * 3) * 0.15
        noteIcon.TextTransparency = 0.2 + math.sin(t * 3 + 1) * 0.2
        noteIcon.Text = (math.floor(t * 2) % 2 == 0) and "♪" or "♫"
    end)
end

local function stopPulse()
    if pulseConn then pulseConn:Disconnect(); pulseConn = nil end
    noteIcon.Text = "♪"
    noteIcon.TextTransparency = 0
    noteIcon.TextColor3 = C.yDim
end

local shimmerConn = nil
local function startShimmer()
    if shimmerConn then shimmerConn:Disconnect() end
    local t = 0
    shimmerConn = RunService.Heartbeat:Connect(function(dt)
        t = t + dt
        local bright = 0.85 + math.sin(t * 4) * 0.15
        playBtn.BackgroundColor3 = Color3.new(bright * 0.7, bright * 0.35, bright)
    end)
end

local function stopShimmer()
    if shimmerConn then shimmerConn:Disconnect(); shimmerConn = nil end
    tween(playBtn, {BackgroundColor3 = C.yellow})
end

local function formatTime(secs)
    local m = math.floor(secs / 60)
    local s = math.floor(secs % 60)
    return string.format("%02d:%02d", m, s)
end

local function startTimer()
    playStartTick = tick()
    if timerConn then timerConn:Disconnect() end
    timerConn = RunService.Heartbeat:Connect(function()
        local elapsed = tick() - playStartTick
        timerLabel.Text = formatTime(elapsed)

        local pct = math.min(elapsed / 300, 1)
        progressBg.Size = UDim2.new(pct, 0, 1, 0)
    end)
end

local function stopTimer()
    if timerConn then timerConn:Disconnect(); timerConn = nil end
    timerLabel.Text = "00:00"
    progressBg.Size = UDim2.new(0, 0, 1, 0)
end

local function setPlaying(on, songName)
    isPlaying = on
    if on then
        playBtn.Text             = "■ หยุดเพลง"
        playBtn.BackgroundColor3 = C.red
        tween(playBtn, {BackgroundColor3 = C.red})
        songLabel.Text      = songName or "กำลังโหลด..."
        songLabel.TextColor3 = C.text
        noteIcon.TextColor3  = C.yellow
        tween(fStroke, {Color = C.yellow})
        tween(sbStroke, {Color = C.yellow})
        startPulse()
        startTimer()
        startShimmer()
    else
        playBtn.Text             = "▶   PLAY"
        playBtn.BackgroundColor3 = C.yellow
        tween(playBtn, {BackgroundColor3 = C.yellow})
        songLabel.Text      = "—  หยุดเพลง"
        songLabel.TextColor3 = C.textDim
        noteIcon.TextColor3  = C.yDim
        tween(fStroke, {Color = C.yellow})
        tween(sbStroke, {Color = C.border})
        stopPulse()
        stopTimer()
        stopShimmer()
    end
end

