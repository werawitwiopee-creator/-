playBtn.MouseButton1Click:Connect(function()
    if isPlaying then
        pcall(function()
            playRemote:FireServer("ToolMusicText", "", nil, true)
        end)
        setPlaying(false)
        currentId = ""
        return
    end

    local rawId = inputBox.Text:gsub("%D","")
    if rawId == "" then
        local origPos = inputBg.Position
        local shakeAmt = 6
        tween(inputBg, {Position = origPos + UDim2.new(0, shakeAmt, 0, 0)}, 0.05)
        task.wait(0.05)
        tween(inputBg, {Position = origPos - UDim2.new(0, shakeAmt, 0, 0)}, 0.05)
        task.wait(0.05)
        tween(inputBg, {Position = origPos + UDim2.new(0, shakeAmt/2, 0, 0)}, 0.05)
        task.wait(0.05)
        tween(inputBg, {Position = origPos}, 0.05)
        tween(inStroke, {Color = C.red}, 0.1)
        task.wait(0.8)
        tween(inStroke, {Color = C.border}, 0.3)
        return
    end

    currentId = rawId

    playBtn.Text = "⏳  LOADING..."
    playBtn.BackgroundColor3 = C.yDim

    task.spawn(function()
        local name = fetchSongName(rawId)
        PlayMusic(rawId)
        setPlaying(true, name or rawId)
    end)
end)

