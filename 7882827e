local function IsHoldingBoombox()
    local char = LocalPlayer.Character
    if not char then return false end
    for _, v in pairs(char:GetChildren()) do
        if v:IsA("Tool") and v.Name:lower():find("boom") then
            return true
        end
    end
    return false
end

local function EquipBoombox()
    if IsHoldingBoombox() then return end
    pcall(function()
        toolRemote:InvokeServer("PickingTools", "Boombox")
    end)
    task.wait(0.5)
end

local function PlayMusic(id)
    id = tostring(id):gsub("%D", "")
    if id == "" then return end
    EquipBoombox()
    playRemote:FireServer("ToolMusicText", id, nil, true)
end

local function fetchSongName(idStr)
    local num = tonumber(idStr:match("^%s*(.-)%s*$"))
    if not num then return nil, "invalid id" end
    local ok, info = pcall(MarketplaceService.GetProductInfo, MarketplaceService, num)
    if ok and info and info.Name then
        return info.Name, nil
    end
    return nil, "not found"
end

