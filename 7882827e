local function setUIOpen(open)
    uiOpen = open
    if open then
        frame.Visible = true
        frame.Size    = UDim2.new(0, 0, 0, 0)
        frame.Position = UDim2.new(0.5, 0, 0.5, 0)
        tween(frame, {
            Size     = UDim2.new(0, 300, 0, 230),
            Position = UDim2.new(0.5, -150, 0.5, -115),
        }, 0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        toggleBtn.Text      = "◈"
        toggleBtn.TextColor3 = C.red
    else
        tween(frame, {
            Size     = UDim2.new(0, 0, 0, 0),
            Position = UDim2.new(0.5, 0, 0.5, 0),
        }, 0.25, Enum.EasingStyle.Back, Enum.EasingDirection.In)
        task.delay(0.26, function()
            if not uiOpen then frame.Visible = false end
        end)
        toggleBtn.Text      = "◈"
        toggleBtn.TextColor3 = C.yellow
    end
end

